<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.LanguageModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        xmlns:Controls="clr-namespace:Amuse.App.Controls"
        mc:Ignorable="d"
        MinWidth="1000"
        MaxWidth="1000"
        MinHeight="620"
        MaxHeight="800"
        Title="Language Model"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LanguageModelDialog}}}" Margin="15, 15, 15, 10">

        <!--Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" Height="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" >
                <Button Content="Save" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top">

            <!--Model Settings-->
            <GroupBox Header="Model" Margin="0,0,0,0">
                <UniformGrid Rows="1">
                    <StackPanel Margin="0,0,2,0">
                        <TextBlock Text="Backend" Style="{StaticResource FieldTextBlockStyle}"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource BackendType}}" SelectedItem="{Binding LanguageModel.Backend}" IsEnabled="False" Style="{StaticResource EnumComboBox}"/>
                    </StackPanel>
                    <StackPanel Margin="2,0,2,0">
                        <TextBlock Text="Pipeline" Style="{StaticResource FieldTextBlockStyle}"/>
                        <ComboBox ItemsSource="{Binding Settings.Pipelines}" SelectedItem="{Binding LanguageModel.Pipeline}" IsEnabled="False" Style="{StaticResource EnumComboBox}"/>
                    </StackPanel>
                    <StackPanel Margin="2,0,2,0">
                        <TextBlock Text="Name" Style="{StaticResource FieldTextBlockStyle}"/>
                        <TextBox Text="{Binding LanguageModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <Grid  Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">

                    <!--Memory Settings-->
                    <GroupBox Header="Memory Profile" Margin="0,0,4,0">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Original Model Data Type" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding LanguageModel.BaseType}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>

                            <TextBlock Text="Memory Modes" Style="{StaticResource FieldTextBlockStyle}" Margin="0,10,0,0"/>
                            <UniformGrid Columns="2" >
                                <TextBlock Text="Quality" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBlock Text="VRAM (GB)" Style="{StaticResource FieldTextBlockStyle}"/>
                            </UniformGrid>

                            <ItemsControl ItemsSource="{Binding LanguageModel.MemoryProfile}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <UniformGrid Columns="2">
                                            <TextBlock Text="{Binding QualityMode}" Margin="0,3,0,0"/>
                                            <TextBox Text="{Binding MemoryModes[0], UpdateSourceTrigger=PropertyChanged}" />
                                        </UniformGrid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                </Grid>

                <Grid Grid.Column="1">

                    <!--Default Settings-->
                    <GroupBox Header="Default Options" Margin="4,0,0,0">
                        <DockPanel>

                            <!--DefaultOptions General-->
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <DockPanel DockPanel.Dock="Bottom">
                                    <StackPanel DockPanel.Dock="Right" Width="100">
                                        <TextBlock Text="Access Token" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <ComboBox SelectedIndex="0" ItemsSource="{Binding AccessTokens}" SelectedValue="{Binding LanguageModel.AccessToken}" SelectedValuePath="Value" DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Repository Link" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <TextBox Text="{Binding LanguageModel.Link, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Visibility="{Binding LanguageModel.DefaultOptions.Tasks, Converter={StaticResource NullOrEmptyVisibilityConverter}}">
                                    <StackPanel DockPanel.Dock="Left" Width="140">
                                        <TextBlock Text="Task" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <TextBox Text="{Binding LanguageModel.DefaultOptions.Task, UpdateSourceTrigger=PropertyChanged}"  />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tasks" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <TextBox Text="{Binding LanguageModel.DefaultOptions.Tasks, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringArrayCommaConverter}}"  />
                                    </StackPanel>
                                </DockPanel>
                            </DockPanel>

                            <!--DefaultOptions-->
                            <Grid>

                                <!--Audio-->
                                <Grid Visibility="{Binding LanguageModel.MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Text}">
                                    <StackPanel>
                                         <UniformGrid Columns="5">
                                            <StackPanel>
                                                <TextBlock Text="MinLength" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <TextBox Text="{Binding LanguageModel.DefaultOptions.MinLength, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="MaxLength" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <TextBox Text="{Binding LanguageModel.DefaultOptions.MaxLength, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                           <StackPanel>
                                                <TextBlock Text="ChunkSize" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <TextBox Text="{Binding LanguageModel.DefaultOptions.ChunkSize, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Beams" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <TextBox Text="{Binding LanguageModel.DefaultOptions.Beams, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="TopK" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <TextBox Text="{Binding LanguageModel.DefaultOptions.TopK, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="TopP" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <CommonControls:FloatBox FloatValue="{Binding LanguageModel.DefaultOptions.TopP, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="TopH" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <CommonControls:FloatBox FloatValue="{Binding LanguageModel.DefaultOptions.TopH, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="TypicalP" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <CommonControls:FloatBox FloatValue="{Binding LanguageModel.DefaultOptions.TypicalP, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Temperature" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <CommonControls:FloatBox FloatValue="{Binding LanguageModel.DefaultOptions.Temperature, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="LengthPenalty" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <CommonControls:FloatBox FloatValue="{Binding LanguageModel.DefaultOptions.LengthPenalty, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="RepetitionPenalty" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <CommonControls:FloatBox FloatValue="{Binding LanguageModel.DefaultOptions.RepetitionPenalty, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="NoRepeatNgramSize" Style="{StaticResource FieldTextBlockStyle}"/>
                                                <TextBox Text="{Binding LanguageModel.DefaultOptions.NoRepeatNgramSize, UpdateSourceTrigger=PropertyChanged}"  />
                                            </StackPanel>
                                            <StackPanel>
                                                <CheckBox Content="Sampling Enabled" IsChecked="{Binding IsSamplingEnabled}" Margin="4,20,0,0"/>
                                            </StackPanel>
                                        </UniformGrid>

                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </GroupBox>

                </Grid>
            </Grid>


            <UniformGrid Rows="1" Margin="0,6,0,0">

                <!--Process Settings-->
                <GroupBox DockPanel.Dock="Top" Header="Supported Functions" Margin="0,0,4,0">
                    <Grid Margin="4">
                        <StackPanel VerticalAlignment="Top"  Visibility="{Binding LanguageModel.MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Text}">
                            <UniformGrid Columns="3" >
                                <CheckBox x:Name="CheckBoxTextToText" Content="TextToText" />
                                <CheckBox x:Name="CheckBoxImageToText" Content="ImageToText" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!--View Filters-->
                <GroupBox DockPanel.Dock="Top" Header="View Filter" Margin="4,0,0,0">
                    <Grid Margin="4">
                        <StackPanel VerticalAlignment="Top"  Visibility="{Binding LanguageModel.MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Text}">
                            <UniformGrid Columns="3" >
                                <CheckBox x:Name="CheckBoxViewImageToText" Content="ImageToText" />
                                <CheckBox x:Name="CheckBoxViewTextInstruct" Content="TextInstruct" />
                                <CheckBox x:Name="CheckBoxViewTextConverse" Content="TextConverse" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </GroupBox>

            </UniformGrid>
        </StackPanel>

        <!--Checkpoint Settings-->
        <Grid Margin="0,10,0,0" >
            <Controls:LanguageCheckpointControl Settings="{Binding Settings}" Checkpoint="{Binding CheckpointModel}" Backend="{Binding LanguageModel.Backend}"/>
        </Grid>
    </DockPanel>
</CommonControls:DialogControl>