<Controls:TextControlBase x:Class="Amuse.App.Controls.ConversationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:CommonConverters="clr-namespace:TensorStack.WPF.Converters;assembly=TensorStack.WPF"
             xmlns:Controls="clr-namespace:Amuse.App.Controls"
             Focusable="True">
    <Controls:TextControlBase.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="X"  Command="{Binding ClearCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:ConversationControl}}}" />
    </Controls:TextControlBase.InputBindings>
    <Border DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Controls:ConversationControl}}, Mode=OneTime}" BorderBrush="{StaticResource ButtonBorderBrush}" Background="{StaticResource ContainerBackground}" BorderThickness="1" >
        <DockPanel>

            <!--Controls-->
            <DockPanel DockPanel.Dock="Bottom" Visibility="{Binding IsToolbarEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" Margin="-1,0,-1,-1" Height="70">

                <!--Progress-->
                <Grid DockPanel.Dock="Top" Height="19">
                    <CommonControls:ProgressElement Height="6" Margin="4,1" Progress="{Binding Progress, Mode=OneWay}" Background="Transparent"/>
                </Grid>

                <!--Load/Save/View-->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsEnabled="{Binding IsInputEnabled, Mode=OneWay}">
                    <Button 
                        ToolTip="Save Response To File" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding SaveCommand, Mode=OneWay}" 
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay}" 
                        Visibility="{Binding IsSaveEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" >
                        <CommonControls:FontAwesome Icon="f0c7" />
                    </Button>
                    <Button 
                        ToolTip="Copy Response Text" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding CopyCommand, Mode=OneWay}" 
                        CommandParameter="{StaticResource False}"
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay}" 
                        Visibility="{Binding IsSaveEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" >
                        <CommonControls:FontAwesome Icon="e8c6" />
                    </Button>
                    <Button 
                        ToolTip="Copy Response Html" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding CopyCommand, Mode=OneWay}" 
                        CommandParameter="{StaticResource True}"
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay}" 
                        Visibility="{Binding IsSaveEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" >
                        <CommonControls:FontAwesome Icon="e83d" />
                    </Button>
                </StackPanel>

                <!--Clear-->
                <DockPanel DockPanel.Dock="Right" Visibility="{Binding IsRemoveEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <Button DockPanel.Dock="Right"
                        ToolTip="Clear Text" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        IsEnabled="{Binding IsInputEnabled, Mode=OneWay}"
                        Command="{Binding ClearCommand}" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay}">
                        <CommonControls:FontAwesome Icon="f2ed" />
                    </Button>

                    <!--Text Info-->
                    <Grid>
                        <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                                <TextBlock Text="Tokens: " Opacity=".7" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"/>
                                <TextBlock Text="{Binding TokenCount, Mode=OneWay, FallbackValue=0}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0" >
                                <TextBlock Text="Length: " Opacity=".7" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"/>
                                <TextBlock Text="{Binding Length, Mode=OneWay, ElementName=ResultControl, FallbackValue=0}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!--Options-->
                <DockPanel MaxWidth="400">
                    <UniformGrid DockPanel.Dock="Left" Rows="1"   Height="26" VerticalAlignment="Center" Margin="10,0,0,0">
                        <CommonControls:ToggleButton
                            Width="30"
                            IconTrue="f120"
                            IconFalse="f120"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Disable Streaming Token Updates"
                            ToolTipFalse="Enable Streaming Token Updates"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsStreamUpdateEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </UniformGrid>
                    <UniformGrid DockPanel.Dock="Right" Rows="1" Height="26" VerticalAlignment="Center" Margin="10,0,0,0">
                        <CommonControls:ToggleButton
                            Width="30"
                            IconTrue="f56c"
                            IconFalse="f56c"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Disable Result Formatting"
                            ToolTipFalse="Enable Result Formatting (experimental)"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsMarkdownEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <CommonControls:ToggleButton
                            Width="30"
                            IconTrue="f0eb"
                            IconFalse="f0eb"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Hide Thinking Content"
                            ToolTipFalse="Show Thinking Content"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsThinkingVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                        <TextBlock />
                        <CommonControls:IconButton
                            Width="30"
                            Icon="f4a7"
                            IconSize="11"
                            IconColor="#80FFFFFF"
                            ToolTip="Rewind Last Message"
                            ToolTipService.Placement="Top"
                            ToolTipService.InitialShowDelay="600"
                            Command="{Binding RewindConversationCommand}"/>
                        <CommonControls:IconButton
                            Width="30"
                            Icon="e1dd"
                            IconSize="11"
                            IconColor="#80FFFFFF"
                            ToolTip="Branch Conversation"
                            ToolTipService.Placement="Top"
                            ToolTipService.InitialShowDelay="600"
                            Command="{Binding BranchConversationCommand}"/>
                    </UniformGrid>
                    <Grid Margin="10,0,0,0">
                        <CommonControls:SliderControl 
                            Text="Refresh Rate" 
                            Minimum="0" 
                            Maximum="500" 
                            TickFrequency="20" 
                            ValuePostFix="ms" 
                            Value="{Binding StreamUpdateInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            IsEnabled="{Binding IsStreamUpdateEnabled, Mode=OneWay}"  />
                    </Grid>

                </DockPanel>
            </DockPanel>

            <!--Main Content-->
            <Border x:Name="DragDropContainer" >
                <Grid x:Name="MainContent" Background="Transparent">
                    <Image Source="{StaticResource PlaceholderText}" Stretch="Uniform" IsHitTestVisible="False"/>
                    <Grid Visibility="{Binding IsContentReady, ElementName=ResultControl, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}">
                        <Controls:MarkdownElement 
                            x:Name="ResultControl" 
                            Settings="{Binding Settings, Mode=OneWay}"
                            IsConversationMode="True"
                            IsThinkingVisible="{Binding IsThinkingVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            IsMarkdownEnabled="{Binding IsMarkdownEnabled, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                            IsInputEnabled="{Binding IsInputEnabled, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                            IsContextMenuEnabled="{Binding IsContextMenuEnabled, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                            IsScrollToBottomEnabled="True"/>
                    </Grid>

                    <!--DragDrop Notification-->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding AllowDrop, ElementName=DragDropContainer, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="False">
                        <CommonControls:FontAwesome Icon="e74c" Size="30" IconStyle="SharpLight" Color="{StaticResource AccentColour2}"/>
                        <TextBlock Text="Drag &amp; Drop Conversation Here" Foreground="{StaticResource AccentColour2}" FontSize="13" FontWeight="DemiBold" Margin="0,6,0,0"/>
                    </StackPanel>

                </Grid>


                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="AllowDrop" Value="False"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsInputEnabled}" Value="True" />
                                    <Condition Binding="{Binding IsDragDrop, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="True" />
                                    <Condition Binding="{Binding DragDropType, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="Conversation" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="AllowDrop" Value="True"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentColour2}"/>
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

        </DockPanel>
    </Border>
</Controls:TextControlBase>
