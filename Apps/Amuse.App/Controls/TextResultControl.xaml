<CommonControls:BaseControl x:Class="Amuse.App.Controls.TextResultControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:CommonConverters="clr-namespace:TensorStack.WPF.Converters;assembly=TensorStack.WPF"
             xmlns:Controls="clr-namespace:Amuse.App.Controls"
             Focusable="True">
    <CommonControls:BaseControl.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="A"  Command="{Binding CopySourceCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}}" />
        <KeyBinding Modifiers="Ctrl" Key="C"  Command="{Binding CopyResponseCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}}" />
        <KeyBinding Modifiers="Ctrl" Key="T"  Command="{Binding CopyThinkingCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveSourceCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}}" />
        <KeyBinding Modifiers="Ctrl" Key="Z"  Command="{Binding ClearCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}}" />
    </CommonControls:BaseControl.InputBindings>
    <Border DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, Mode=OneTime}" BorderBrush="{StaticResource ButtonBorderBrush}" Background="{StaticResource ContainerBackground}" BorderThickness="1" >
        <DockPanel>

            <!--Controls-->
            <DockPanel DockPanel.Dock="Bottom" Visibility="{Binding IsToolbarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="-1,0,-1,-1" Height="70">

                <!--Progress-->
                <Grid DockPanel.Dock="Top" Height="19">
                    <CommonControls:ProgressElement Height="6" Margin="4,1" Progress="{Binding Progress}" Background="Transparent"/>
                </Grid>

                <!--Load/Save/View-->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button 
                        ToolTip="Save Text File" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding SaveSourceCommand}" 
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" 
                        Visibility="{Binding IsSaveEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" >
                        <CommonControls:FontAwesome Icon="f0c7" />
                    </Button>
                    <Button 
                        ToolTip="Copy Response" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding CopyResponseCommand}" 
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" 
                        Visibility="{Binding IsSaveEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" >
                        <CommonControls:FontAwesome Icon="f0c5" />
                    </Button>
                </StackPanel>

                <!--Clear-->
                <DockPanel DockPanel.Dock="Right" Visibility="{Binding IsRemoveEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button DockPanel.Dock="Right"
                        ToolTip="Clear Text" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding ClearCommand}" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">
                        <CommonControls:FontAwesome Icon="f2ed" />
                    </Button>

                    <!--Text Info-->
                    <Grid>
                        <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                                <TextBlock Text="Tokens: " Opacity=".7" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedResult.TokenCount, FallbackValue=0}" Visibility="{Binding Result, Converter={StaticResource NullVisibilityConverter}}"/>
                                <TextBlock Text="{Binding PreviewTokenCount, FallbackValue=0}" Visibility="{Binding Result, Converter={StaticResource InverseNullVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0" >
                                <TextBlock Text="Length: " Opacity=".7" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedResult.Length, FallbackValue=0}" Visibility="{Binding Result, Converter={StaticResource NullVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Length, ElementName=PreviewControl, FallbackValue=0}" Visibility="{Binding Result, Converter={StaticResource InverseNullVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                </DockPanel>

                <DockPanel MaxWidth="400">
                    <UniformGrid DockPanel.Dock="Left" Rows="1"   Height="26" VerticalAlignment="Center" Margin="10,0,0,0">
                        <CommonControls:ToggleButton
                            Width="30"
                            IconTrue="f120"
                            IconFalse="f120"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Disable Token Preview"
                            ToolTipFalse="Enable Token Preview"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsPreviewEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <CommonControls:ToggleButton
                            IconTrue="e698"
                            IconFalse="e698"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Disable Preview Formatting"
                            ToolTipFalse="Enable Preview Formatting (experimental)"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsPreviewMarkdownEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </UniformGrid>
                    <UniformGrid DockPanel.Dock="Right" Rows="1" Height="26" VerticalAlignment="Center" Margin="10,0,0,0">
                        <CommonControls:ToggleButton
                            Width="30"
                            IconTrue="f56c"
                            IconFalse="f56c"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Disable Result Formatting"
                            ToolTipFalse="Enable Result Formatting (experimental)"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsResultMarkdownEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <CommonControls:ToggleButton
                            Width="30"
                            IconTrue="f0eb"
                            IconFalse="f0eb"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Hide Thinking Content"
                            ToolTipFalse="Show Thinking Content"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsThinkingVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </UniformGrid>
                    <CommonControls:SliderControl Text="Refresh Rate" Minimum="50" Maximum="1000" TickFrequency="50" ValuePostFix="ms" Value="{Binding PreviewRefreshInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="10,0,0,0"/>
                </DockPanel>

            </DockPanel>

            <!--Main Content-->
            <Border x:Name="DragDropContainer">
                <Grid x:Name="MainContent" Background="Transparent">

                    <!--PlaceHolder-->
                    <Image Source="{Binding Placeholder, TargetNullValue={StaticResource PlaceholderText}}" Stretch="Uniform" IsHitTestVisible="False"/>

                    <!--Text Result-->
                    <Grid Visibility="{Binding Result, Converter={StaticResource NullOrEmptyVisibilityConverter}}" Background="{StaticResource ControlDefaultBackground}">

                        <!--Single Result-->
                        <Grid Visibility="{Binding Result.IsMultipleResult, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Controls:MarkdownElement 
                                x:Name="ResultControl" 
                                Settings="{Binding Settings, Mode=OneWay}"
                                Markdown="{Binding Result.Result.Text}" 
                                IsThinkingVisible="{Binding IsThinkingVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                IsMarkdownEnabled="{Binding IsResultMarkdownEnabled, UpdateSourceTrigger=PropertyChanged}"
                                IsScrollToBottomEnabled="{Binding IsPreviewEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!--Multiple Result-->
                        <Grid Visibility="{Binding Result.IsMultipleResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TabControl x:Name="ResultTabControl" ItemsSource="{Binding Result.Results}" SelectedItem="{Binding SelectedResult}" Padding="0" BorderThickness="0">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Beam, StringFormat={}Beam {0}}" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding Score, StringFormat={}Score: {0:F4}}" FontSize="8" FontStyle="Italic" Opacity=".6" TextAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <Controls:MarkdownElement 
                                            Settings="{Binding Settings, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, Mode=OneWay}"
                                            IsThinkingVisible="{Binding IsThinkingVisible, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            IsMarkdownEnabled="{Binding IsResultMarkdownEnabled, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, UpdateSourceTrigger=PropertyChanged}"
                                            IsScrollToBottomEnabled="False"
                                            Markdown="{Binding Text}" />
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                                <TabControl.Template>
                                    <ControlTemplate TargetType="TabControl">
                                        <DockPanel>
                                            <UniformGrid IsItemsHost="True" Rows="1" DockPanel.Dock="Top"></UniformGrid>
                                            <ContentPresenter ContentSource="SelectedContent"></ContentPresenter>
                                        </DockPanel>
                                    </ControlTemplate>
                                </TabControl.Template>
                            </TabControl>
                        </Grid>
                    </Grid>

                    <!--Preview-->
                    <Grid Visibility="{Binding IsPreviewEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Visibility="{Binding IsContentReady, ElementName=PreviewControl, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <Controls:MarkdownElement 
                                x:Name="PreviewControl" 
                                Settings="{Binding Settings, Mode=OneWay}"
                                IsThinkingVisible="{Binding IsThinkingVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                IsMarkdownEnabled="{Binding IsPreviewMarkdownEnabled, UpdateSourceTrigger=PropertyChanged}"
                                IsScrollToBottomEnabled="{Binding IsPreviewEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Grid>

                    <!--ContextMenu-->
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Save As" InputGestureText="Ctrl+S" Command="{Binding SaveSourceCommand}">
                                <MenuItem.Icon>
                                    <CommonControls:FontAwesome Icon="f0c7" IconStyle="Light" Size="15"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy All" InputGestureText="Ctrl+A" Command="{Binding CopySourceCommand}">
                                <MenuItem.Icon>
                                    <CommonControls:FontAwesome Icon="f0c5" IconStyle="Light" Size="15" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy Response" InputGestureText="Ctrl+C" Command="{Binding CopyResponseCommand}">
                                <MenuItem.Icon>
                                    <CommonControls:FontAwesome Icon="f0c5" IconStyle="Light" Size="15" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy Thinking" InputGestureText="Ctrl+T" Command="{Binding CopyThinkingCommand}">
                                <MenuItem.Icon>
                                    <CommonControls:FontAwesome Icon="f0c5" IconStyle="Light" Size="15" />
                                </MenuItem.Icon>
                            </MenuItem>
                         
                            <MenuItem Header="Clear" InputGestureText="Ctrl+Z" Command="{Binding ClearCommand}">
                                <MenuItem.Icon>
                                    <CommonControls:FontAwesome Icon="f2ed" IconStyle="Light" Size="15"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <ContextMenu.Style>
                                <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInputEnabled}" Value="True"/>
                                                <Condition Binding="{Binding IsContextMenuEnabled}" Value="True"/>
                                                <Condition Binding="{Binding IsResultMarkdownEnabled}" Value="false"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContextMenu.Style>
                        </ContextMenu>
                    </Grid.ContextMenu>

                </Grid>
            </Border>
        </DockPanel>
    </Border>
</CommonControls:BaseControl>
