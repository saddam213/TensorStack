<Controls:TextControlBase x:Class="Amuse.App.Controls.TextResultControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:CommonConverters="clr-namespace:TensorStack.WPF.Converters;assembly=TensorStack.WPF"
             xmlns:Controls="clr-namespace:Amuse.App.Controls"
             Focusable="True">
    <Controls:TextControlBase.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="X"  Command="{Binding ClearCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}}" />
    </Controls:TextControlBase.InputBindings>
    <Border DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, Mode=OneTime}" BorderBrush="{StaticResource ButtonBorderBrush}" Background="{StaticResource ContainerBackground}" BorderThickness="1" >
        <DockPanel>

            <!--Controls-->
            <DockPanel DockPanel.Dock="Bottom" Visibility="{Binding IsToolbarEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="-1,0,-1,-1" Height="70">

                <!--Progress-->
                <Grid DockPanel.Dock="Top" Height="19">
                    <CommonControls:ProgressElement Height="6" Margin="4,1" Progress="{Binding Progress, Mode=OneWay}" Background="Transparent"/>
                </Grid>

                <!--Load/Save/View-->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsEnabled="{Binding IsInputEnabled, Mode=OneWay}">
                    <Button 
                        ToolTip="Save Response To File" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding SaveCommand, Mode=OneWay}" 
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay}" 
                        Visibility="{Binding IsSaveEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" >
                        <CommonControls:FontAwesome Icon="f0c7" />
                    </Button>
                    <Button 
                        ToolTip="Copy Response Text" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding CopyCommand, Mode=OneWay}" 
                        CommandParameter="{StaticResource False}"
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay}" 
                        Visibility="{Binding IsSaveEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" >
                        <CommonControls:FontAwesome Icon="e8c6" />
                    </Button>
                    <Button 
                        ToolTip="Copy Response Html" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding CopyCommand, Mode=OneWay}" 
                        CommandParameter="{StaticResource True}"
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay}" 
                        Visibility="{Binding IsSaveEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" >
                        <CommonControls:FontAwesome Icon="e83d" />
                    </Button>
                </StackPanel>

                <!--Clear-->
                <DockPanel DockPanel.Dock="Right" Visibility="{Binding IsRemoveEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <Button DockPanel.Dock="Right"
                        ToolTip="Clear Text" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding ClearCommand}" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                        IsEnabled="{Binding IsInputEnabled, Mode=OneWay}">
                        <CommonControls:FontAwesome Icon="f2ed" />
                    </Button>

                    <!--Text Info-->
                    <Grid>
                        <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                                <TextBlock Text="Tokens: " Opacity=".7" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"/>
                                <TextBlock Text="{Binding TokenCount, FallbackValue=0, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0" >
                                <TextBlock Text="Length: " Opacity=".7" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"/>
                                <TextBlock Text="{Binding Length, ElementName=ResultControl, FallbackValue=0, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!--Options-->
                <DockPanel MaxWidth="400">
                    <UniformGrid DockPanel.Dock="Left" Rows="1"   Height="26" VerticalAlignment="Center" Margin="10,0,0,0">
                        <CommonControls:ToggleButton
                            Width="30"
                            IconTrue="f120"
                            IconFalse="f120"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Disable Streaming Token Updates"
                            ToolTipFalse="Enable Streaming Token Updates"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsStreamUpdateEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            IsEnabled="{Binding IsMultipleBeamResult, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"/>
                    </UniformGrid>
                    <UniformGrid DockPanel.Dock="Right" Rows="1" Height="26" VerticalAlignment="Center" Margin="10,0,0,0">
                        <CommonControls:ToggleButton
                            Width="30"
                            IconTrue="f56c"
                            IconFalse="f56c"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Disable Result Formatting"
                            ToolTipFalse="Enable Result Formatting (experimental)"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsMarkdownEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <CommonControls:ToggleButton
                            Width="30"
                            IconTrue="f0eb"
                            IconFalse="f0eb"
                            SizeTrue="11"
                            SizeFalse="11"
                            ColorTrue="#80FFFFFF"
                            ColorFalse="#25FFFFFF"
                            ToolTipTrue="Hide Thinking Content"
                            ToolTipFalse="Show Thinking Content"
                            ToolTipPlacement="Top"
                            ToolTipInitialDelay="600"
                            IsChecked="{Binding IsThinkingVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </UniformGrid>
                    <Grid IsEnabled="{Binding IsMultipleBeamResult, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" Margin="10,0,0,0">
                        <CommonControls:SliderControl 
                            Text="Refresh Rate" 
                            Minimum="0" 
                            Maximum="500" 
                            TickFrequency="20" 
                            ValuePostFix="ms" 
                            Value="{Binding StreamUpdateInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                            IsEnabled="{Binding IsStreamUpdateEnabled, Mode=OneWay}" />
                    </Grid>

                </DockPanel>
            </DockPanel>

            <!--Main Content-->
            <Border x:Name="DragDropContainer">
                <Grid x:Name="MainContent" Background="Transparent">
                    <Image Source="{StaticResource PlaceholderText}" Stretch="Uniform" IsHitTestVisible="False"/>

                    <!--Single Result-->
                    <Grid Visibility="{Binding IsMultipleBeamResult, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                        <Grid Visibility="{Binding IsContentReady, ElementName=ResultControl, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}">
                            <Controls:MarkdownElement 
                                x:Name="ResultControl" 
                                Settings="{Binding Settings, Mode=OneWay}"
                                IsInputEnabled="{Binding IsInputEnabled, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                IsContextMenuEnabled="{Binding IsContextMenuEnabled, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                IsThinkingVisible="{Binding IsThinkingVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                IsMarkdownEnabled="{Binding IsMarkdownEnabled, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                IsScrollToBottomEnabled="{Binding IsStreamUpdateEnabled, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
                        </Grid>
                    </Grid>

                    <!--Multiple Result-->
                    <Grid Visibility="{Binding IsMultipleBeamResult, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <TabControl x:Name="ResultTabControl" ItemsSource="{Binding BeamResults, Mode=OneWay}" SelectedItem="{Binding SelectedBeamResult, Mode=TwoWay}" Padding="0" BorderThickness="0">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Beam, Mode=OneWay, StringFormat={}Beam {0}}" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Score, Mode=OneWay, StringFormat={}Score: {0:F4}}" FontSize="8" FontStyle="Italic" Opacity=".6" TextAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Controls:MarkdownElement 
                                        IsScrollToBottomEnabled="False"
                                        Settings="{Binding Settings, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, Mode=OneWay}"
                                        IsThinkingVisible="{Binding IsThinkingVisible, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        IsMarkdownEnabled="{Binding IsMarkdownEnabled, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                        IsContextMenuEnabled="{Binding IsContextMenuEnabled, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                        Markdown="{Binding Text, Mode=OneWay}" />
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <DockPanel>
                                        <UniformGrid IsItemsHost="True" Rows="1" DockPanel.Dock="Top"></UniformGrid>
                                        <ContentPresenter ContentSource="SelectedContent"></ContentPresenter>
                                    </DockPanel>
                                </ControlTemplate>
                            </TabControl.Template>
                        </TabControl>
                    </Grid>

                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Controls:TextControlBase>
