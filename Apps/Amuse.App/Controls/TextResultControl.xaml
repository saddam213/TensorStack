<CommonControls:BaseControl x:Class="Amuse.App.Controls.TextResultControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:CommonConverters="clr-namespace:TensorStack.WPF.Converters;assembly=TensorStack.WPF"
             xmlns:Controls="clr-namespace:Amuse.App.Controls"
             Focusable="True">
    <CommonControls:BaseControl.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="C"  Command="{Binding CopySourceCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveSourceCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}}" />
        <KeyBinding Modifiers="Ctrl" Key="Z"  Command="{Binding ClearCommand, Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}}" />
    </CommonControls:BaseControl.InputBindings>
    <Border DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Controls:TextResultControl}}, Mode=OneTime}" BorderBrush="{StaticResource ButtonBorderBrush}" Background="{StaticResource ContainerBackground}" BorderThickness="1" >
        <Border.Resources>
            <Style x:Key="TextResultStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
            </Style>
        </Border.Resources>
        <DockPanel>

            <!--Controls-->
            <DockPanel DockPanel.Dock="Bottom" Visibility="{Binding IsToolbarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="-1,0,-1,-1" Height="70">

                <!--Progress-->
                <Grid DockPanel.Dock="Top" Height="19">
                    <CommonControls:ProgressElement Height="6" Margin="4,1" Progress="{Binding Progress}" Background="Transparent"/>
                </Grid>

                <!--Load/Save/View-->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button 
                        ToolTip="Save Text File" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding SaveSourceCommand}" 
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" 
                        Visibility="{Binding IsSaveEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" >
                        <CommonControls:FontAwesome Icon="f0c7" />
                    </Button>
                </StackPanel>

                <!--Clear-->
                <Grid DockPanel.Dock="Right" Visibility="{Binding IsRemoveEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button 
                        ToolTip="Clear Text" 
                        ToolTipService.Placement="Top"
                        ToolTipService.InitialShowDelay="600" 
                        Command="{Binding ClearCommand}" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">
                        <CommonControls:FontAwesome Icon="f2ed" />
                    </Button>
                </Grid>

                <!--Text Info-->
                <Grid>
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,-2" Visibility="{Binding Result.IsMultipleResult, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Beam: " Opacity=".7" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedResult.Beam, FallbackValue=0}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                            <TextBlock Text="Length: " Opacity=".7" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedResult.Length, FallbackValue=0}" Visibility="{Binding Result, Converter={StaticResource NullVisibilityConverter}}"/>
                            <TextBlock Text="{Binding Preview.Length, FallbackValue=0}" Visibility="{Binding Result, Converter={StaticResource InverseNullVisibilityConverter}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-2,0,0" Visibility="{Binding Result.IsMultipleResult, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Score: " Opacity=".7" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedResult.Score, FallbackValue=0, StringFormat={}{0:N4}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </DockPanel>

            <!--Main Content-->
            <Border x:Name="DragDropContainer">
                <Grid x:Name="MainContent" Background="Transparent">

                    <!--PlaceHolder-->
                    <Image Source="{Binding Placeholder, TargetNullValue={StaticResource PlaceholderText}}" Stretch="Uniform" IsHitTestVisible="False">
                        <Image.Style>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result, Converter={StaticResource NullBooleanConverter}}" Value="false">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!--Text Result-->
                    <Grid Visibility="{Binding Result, Converter={StaticResource NullOrEmptyVisibilityConverter}}">

                        <!--Single Result-->
                        <Grid Visibility="{Binding Result.IsMultipleResult, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" >
                                <i:Interaction.Behaviors>
                                    <Behaviors:AutoScrollBehavior ScrollThreshold="100"/>
                                </i:Interaction.Behaviors>
                                <TextBox Text="{Binding Result.Result.Text}" Style="{StaticResource TextResultStyle}"/>
                            </ScrollViewer>
                        </Grid>

                        <!--Multiple Result-->
                        <Grid Visibility="{Binding Result.IsMultipleResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TabControl ItemsSource="{Binding Result.Results}" SelectedItem="{Binding SelectedResult}" Padding="0" BorderThickness="0">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Beam, StringFormat={}Beam {0}}" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding Score, StringFormat={}Score: {0:F4}}" FontSize="8" FontStyle="Italic" Opacity=".6" TextAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" >
                                            <i:Interaction.Behaviors>
                                                <Behaviors:AutoScrollBehavior ScrollThreshold="100"/>
                                            </i:Interaction.Behaviors>
                                            <TextBox Text="{Binding Text}" Style="{StaticResource TextResultStyle}"/>
                                        </ScrollViewer>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                                <TabControl.Template>
                                    <ControlTemplate TargetType="TabControl">
                                        <DockPanel>
                                            <UniformGrid IsItemsHost="True" Rows="1" DockPanel.Dock="Top"></UniformGrid>
                                            <ContentPresenter ContentSource="SelectedContent"></ContentPresenter>
                                        </DockPanel>
                                    </ControlTemplate>
                                </TabControl.Template>
                            </TabControl>
                        </Grid>
                    </Grid>

                    <!--Preview-->
                    <Grid Visibility="{Binding Preview, Converter={StaticResource NullOrEmptyVisibilityConverter}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" >
                            <i:Interaction.Behaviors>
                                <Behaviors:AutoScrollBehavior ScrollThreshold="100"/>
                            </i:Interaction.Behaviors>
                            <TextBox Text="{Binding Preview, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextResultStyle}" Background="{StaticResource ContainerBackground}"/>
                        </ScrollViewer>
                    </Grid>

                    <!--ContextMenu-->
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="{Binding CopySourceCommand}">
                                <MenuItem.Icon>
                                    <CommonControls:FontAwesome Icon="f0c5" IconStyle="Light" Size="15" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save" InputGestureText="Ctrl+S" Command="{Binding SaveSourceCommand}">
                                <MenuItem.Icon>
                                    <CommonControls:FontAwesome Icon="f0c7" IconStyle="Light" Size="15"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Clear" InputGestureText="Ctrl+Z" Command="{Binding ClearCommand}">
                                <MenuItem.Icon>
                                    <CommonControls:FontAwesome Icon="f2ed" IconStyle="Light" Size="15"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <ContextMenu.Style>
                                <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInputEnabled}" Value="True"/>
                                                <Condition Binding="{Binding IsContextMenuEnabled}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContextMenu.Style>
                        </ContextMenu>
                    </Grid.ContextMenu>

                </Grid>
            </Border>
        </DockPanel>
    </Border>
</CommonControls:BaseControl>
