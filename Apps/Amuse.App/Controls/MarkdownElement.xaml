<CommonControls:BaseControl x:Class="Amuse.App.Controls.MarkdownElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Amuse.App.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             Background="#FF272727">
    <ScrollViewer x:Name="ScrollViewerHost" DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MarkdownElement}}}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ScrollChanged="ScrollViewerHost_ScrollChanged" >
        <i:Interaction.Behaviors>
            <Behaviors:AutoScrollBehavior IsEnabled="{Binding IsScrollToBottomEnabled}"/>
        </i:Interaction.Behaviors>
        <Grid>
            <wv2:WebView2 x:Name="WebViewer" 
                SnapsToDevicePixels="True" 
                UseLayoutRounding="True" 
                DefaultBackgroundColor="#FF2D2D2D"
                ZoomFactor="{Binding Settings.UIScale, Mode=OneWay}">
            </wv2:WebView2>
            <TextBox x:Name="TextViewer" 
                Background="{StaticResource ControlDefaultBackground}" 
                TextWrapping="Wrap" 
                IsReadOnly="True" 
                BorderThickness="0" 
                IsUndoEnabled="False" 
                UndoLimit="0" 
                Padding="4" >
            </TextBox>
        </Grid>
    </ScrollViewer>
</CommonControls:BaseControl>
