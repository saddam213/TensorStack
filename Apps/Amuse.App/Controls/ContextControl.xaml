<CommonControls:BaseControl x:Class="Amuse.App.Controls.ContextControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Amuse.App.Controls"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ContextControl}}}">
        <UniformGrid Rows="1" Height="35" DockPanel.Dock="Bottom">
            <Button Command="{Binding AddTextCommand}">
                <CommonControls:FontAwesome Icon="f15c"/>
            </Button>
            <Button Command="{Binding AddImageCommand}">
                <CommonControls:FontAwesome Icon="f03e"/>
            </Button>
            <Button Command="{Binding AddAudioCommand}">
                <CommonControls:FontAwesome Icon="f001"/>
            </Button>
            <Button Command="{Binding AddVideoCommand}">
                <CommonControls:FontAwesome Icon="f008"/>
            </Button>
            <Button Command="{Binding ClearCommand}" >
                <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}"/>
            </Button>
        </UniformGrid>
        <Grid Margin="0,0,0,6">
            <Grid.Resources>
                <CollectionViewSource x:Key="ContextView" Source="{Binding ContextCollection}" IsLiveSortingRequested="True">
                    <CollectionViewSource.SortDescriptions>
                        <scm:SortDescription PropertyName="IsIgnored" Direction="Ascending"/>
                        <scm:SortDescription PropertyName="Id" Direction="Descending"/>
                    </CollectionViewSource.SortDescriptions>
                </CollectionViewSource>
            </Grid.Resources>

            <ListBox ItemsSource="{Binding Source={StaticResource ContextView}}" SelectedItem="{Binding SelectedContextItem}" ItemContainerStyle="{StaticResource SettingsListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" AlternationCount="1000000">
                <ListBox.Resources>

                    <DataTemplate  DataType="{x:Type local:ContextItemModel}" >
                        <DockPanel ToolTip="{Binding ToolTipMessage}">
                            <Border DockPanel.Dock="Left" Width="30" Height="30" Margin="3">
                                <Grid>
                                    <!--Text-->
                                    <Border BorderThickness="1" BorderBrush="{StaticResource DefaultForeground}" Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Text}">
                                        <CommonControls:FontAwesome Icon="f15c"/>
                                    </Border>

                                    <!--Audio-->
                                    <Border BorderThickness="1" BorderBrush="{StaticResource DefaultForeground}" Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Audio}">
                                        <CommonControls:FontAwesome Icon="f001"/>
                                    </Border>

                                    <!--Image-->
                                    <CommonControls:TransparentImageElement 
                                            Height="30" 
                                            Stretch="Uniform" 
                                            DecodePixelHeight="30"
                                            BitmapSource="{Binding Image, Converter={StaticResource ImageTensorToBitmapConverter}}" 
                                            Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Image}" />

                                    <!--Video-->
                                    <CommonControls:TransparentImageElement 
                                            Height="30" 
                                            Stretch="Uniform" 
                                            DecodePixelHeight="30"
                                            BitmapSource="{Binding Video.Thumbnail, Converter={StaticResource ImageTensorToBitmapConverter}}" 
                                            Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Video}" />
                                </Grid>
                            </Border>

                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,0" >
                                <CommonControls:FontAwesome Icon="f30d" IconStyle="Solid" Opacity=".4" Margin="2,2,3,2"/>
                                <Button Command="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ContextControl}}}" CommandParameter="{Binding}" Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <CommonControls:FontAwesome Icon="f00d" Size="13" Color="{StaticResource DangerColour}" Opacity="1" Margin="2"/>
                                </Button>
                            </Grid>

                            <StackPanel Margin="3">
                                <TextBlock Text="Document" Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Text}"/>
                                <TextBlock Text="{Binding MediaType}" Visibility="{Binding MediaType, Converter={StaticResource InverseEnumToVisibilityConverter}, ConverterParameter=Text}"/>
                                <TextBlock Text="{Binding Filename, Converter={StaticResource FullPathToFileNameConverter}}" FontStyle="Italic" Opacity=".8"/>
                            </StackPanel>

                            <DockPanel.Style>
                                <Style TargetType="{x:Type DockPanel}">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                            <Setter Property="Opacity" Value=".2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <Border BorderThickness="1">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllowDrop, RelativeSource={RelativeSource AncestorType={x:Type local:ContextControl}}}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessColour}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"  Visibility="{Binding ContextCollection.Count, Converter={StaticResource LessThanToVisibilityConverter}, ConverterParameter=1}" Opacity=".6" Margin="0,-40,0,0">
                    <TextBlock Text="Attach Documents / Media" TextAlignment="Center"/>
                    <TextBlock Text="Provides additional context for your conversation" TextAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</CommonControls:BaseControl>
