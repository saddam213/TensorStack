<Views:ViewBaseDiffusion x:Class="Amuse.App.Views.TextInstructView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Amuse.App.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Amuse.App.Controls"
    xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
    xmlns:Views="clr-namespace:Amuse.App.Views">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TextInstructView}}}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="380" MaxWidth="{Binding ActualWidth, Converter={StaticResource DivideByConverter}, ConverterParameter=2}"/>
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!--***Left Panel***-->
        <Grid Grid.Column="0">
            <Border Margin="4">
                <DockPanel x:Name="LeftPanelContainer" Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}}">

                    <!--ModelControl-->
                    <Grid DockPanel.Dock="Top" IsEnabled="{Binding DiffusionService.IsLoading, Converter={StaticResource InverseBoolConverter}}">
                        <Grid IsEnabled="{Binding DiffusionService.IsExecuting, Converter={StaticResource InverseBoolConverter}}">
                            <Grid IsEnabled="{Binding IsAutomating, Converter={StaticResource InverseBoolConverter}}">
                                <Controls:TextModelControl
                                        x:Name="ModelControl"
                                        ViewType="TextInstruct"
                                        ProcessType="TextToText"
                                        Settings="{Binding Settings, Mode=OneWay}" 
                                        IsPipelineLoaded="{Binding IsPipelineLoaded, Mode=OneWay}"
                                        DownloadService="{Binding DownloadService, Mode=OneTime}"
                                        NavigationService="{Binding NavigationService, Mode=OneTime}"
                                        SelectionChanged="SelectedPipelineChanged"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <DockPanel DockPanel.Dock="Bottom">

                        <!--Statistics-->
                        <Controls:StatisticsControl 
                                DockPanel.Dock="Bottom"
                                PrefixPerSecond="tok/s"
                                PrefixSecondsPer="s/tok"
                                Statistics="{Binding Statistics}"
                                Progress="{Binding Progress}"/>


                        <!--Execute/Cancel-->
                        <!--<UniformGrid DockPanel.Dock="Bottom" Columns="2" Height="30" >
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Width="30" Command="{Binding StopCommand}" Visibility="{Binding DiffusionService.IsCanceling, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Immediately stops generation by closing the backend process." ToolTipService.InitialShowDelay="200">
                                        <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}" />
                                    </Button>
                                    <Grid IsEnabled="{Binding DiffusionService.IsCanceling, Converter={StaticResource InverseBoolConverter}}">
                                        <Button Command="{Binding CancelCommand}" >
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Cancel" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DiffusionService.IsCanceling}" Value="True">
                                                            <Setter Property="Content" Value="Canceling" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DockPanel>
                                <Grid IsEnabled="{Binding IsSelectionValid, ElementName=ModelControl}">
                                    <Button Content="Generate" Command="{Binding ExecuteCommand}" Visibility="{Binding SelectedOption, ElementName=InputControl, Converter={StaticResource InverseEnumToVisibilityConverter}, ConverterParameter=Automation}"/>
                                    <Button Content="Automate" Command="{Binding ExecuteAutomationCommand}" Visibility="{Binding SelectedOption, ElementName=InputControl, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Automation}"/>
                                </Grid>
                            </UniformGrid>-->

                        <!--InputControl-->
                        <StackPanel >
                            <!--<StackPanel IsEnabled="{Binding IsAutomating, Converter={StaticResource InverseBoolConverter}}">
                                    <TextBlock Text="Text Input" Style="{StaticResource FieldTextBlockStyle}" />
                                    <Border Style="{StaticResource AudioDropZoneStyle}" IsEnabled="{Binding DiffusionService.IsExecuting, Converter={StaticResource InverseBoolConverter}}">
                                        <CommonControls:TextElement 
                                            x:Name="InputTextControl"
                                            Height="400"
                                            TextSource="{Binding SourceText, Mode=TwoWay}" 
                                            OnMediaImport="OnMediaImport"/>
                                    </Border>
                                </StackPanel>-->

                            <!--InputControl-->
                            <Grid IsEnabled="{Binding DiffusionService.IsLoaded}" >
                                <Controls:TextInputControl
                                        x:Name="InputControl"
                                        ViewType="TextInstruct"
                                        ProcessType="TextToText"
                                        Options="{Binding Options, Mode=OneWayToSource}"
                                        AutomationOptions="{Binding AutomationOptions, Mode=OneWayToSource}"
                                        AutomationProgress="{Binding AutomationProgress, Mode=OneWay}"
                                        Pipeline="{Binding CurrentPipeline, Mode=OneWay}" 
                                        IsExecuting="{Binding DiffusionService.IsExecuting, Mode=OneWay}"
                                        IsAutomating="{Binding IsAutomating, Mode=OneWay}"
                                        IsEnabled="{Binding CurrentPipeline, Converter={StaticResource InverseNullBooleanConverter}, Mode=OneWay}"/>
                            </Grid>

                        </StackPanel>

                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>


        <!--GridSplitter-->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" Opacity=".4" Margin="0,20" />


        <!--***Right Panel***-->
        <Grid x:Name="RightPanelContainer" Grid.Column="2" Grid.Row="0" >


            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="160" MinHeight="100" MaxHeight="{Binding ActualHeight, ElementName=RightPanelContainer, Converter={StaticResource SubtractIntConverter}, ConverterParameter=110}"/>
            </Grid.RowDefinitions>

            <!--Content-->
            <DockPanel Grid.Row="0">
                <Border Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}}">
                    <Grid Margin="10,4,10,2">
                        <Controls:TextResultControl x:Name="TextResult" Settings="{Binding Settings, Mode=OneWay}" Result="{Binding ResultText, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </DockPanel>


            <!--GridSplitter-->
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="5" Opacity=".4" Style="{StaticResource GridSplitterHorizontal}" Margin="20, 0"/>


            <Grid Grid.Row="2" IsEnabled="{Binding IsPipelineLoaded}">
                <DockPanel  Margin="14, 6,14,8" >
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,2,0,0">
                        <UniformGrid DockPanel.Dock="Left" Rows="1" Height="25">
                            <Button Content="x"  Width="50"/>
                            <Button Content="x" />
                        </UniformGrid>
                        <UniformGrid DockPanel.Dock="Right" Rows="1" Height="25">
                            <Button Content="Cancel" Command="{Binding CancelCommand}" />
                            <Button Content="Send" Command="{Binding ExecuteCommand}" Width="100" IsDefault="True"/>
                        </UniformGrid>
                        <Grid>
                        </Grid>
                    </DockPanel>
                    <CommonControls:PlaceholderTextBox Text="{Binding Options.Prompt, Mode=TwoWay}" TextPadding="2,2,2,10" AcceptsReturn="True" TextWrapping="Wrap" PreviewKeyDown="SourceText_PreviewKeyDown" Placeholder="Describe the image"/>
                </DockPanel>
            </Grid>

        </Grid>
    </Grid>
</Views:ViewBaseDiffusion>
