<Controls:BaseControl x:Class="TensorStack.WPF.Controls.LocalizationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:TensorStack.WPF.Controls"
             mc:Ignorable="d" >
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Controls:LocalizationControl}}}">
        <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="Name"/>
    </Grid>
</Controls:BaseControl>
