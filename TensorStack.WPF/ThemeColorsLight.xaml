    <!-- 12x12 tile; light gray background + two darker squares -->
    <DrawingBrush x:Key="CheckerBrush"
           TileMode="Tile"
           Viewport="0,0,12,12"
           ViewportUnits="Absolute"
           Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFF5F5F5" Geometry="M0,0 L12,0 12,12 0,12 Z"/>
                <GeometryDrawing Brush="#FFE3E3E3" Geometry="M0,0 L6,0 6,6 0,6 Z"/>
                <GeometryDrawing Brush="#FFE3E3E3" Geometry="M6,6 L12,6 12,12 6,12 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>





